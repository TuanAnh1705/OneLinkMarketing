# ── Strapi CMS ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRAPI_API_URL=https://cms.onelinkmarketing.com
# Optional: public media host if different from the API host (CDN in front of Strapi)
STRAPI_PUBLIC_URL=

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://onelinkmarketing.com

# ── Upstash Redis (cache tier 3 + rate limiting) ──────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cloudflare (edge cache purge on Strapi publish) ───────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ── Revalidate webhook (set the same secret in the Strapi publish webhook) ────
# Strapi → Settings → Webhooks → URL: https://onelinkmarketing.com/api/revalidate?secret=YOUR_SECRET
REVALIDATE_SECRET=
